# Backend API root used by Next.js proxy routes.
BACKEND_BASE_URL=http://127.0.0.1:8000

# Better Auth base URL and secrets.
BETTER_AUTH_URL=http://127.0.0.1:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=
# Comma-separated extra origins allowed for auth callbacks/redirects.
# BETTER_AUTH_URL origin is trusted automatically.
BETTER_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000
# Optional: memory|database|secondary-storage
BETTER_AUTH_RATE_LIMIT_STORAGE=memory

# Frontend server-side DB connection used by Drizzle + Better Auth.
# Use Supabase transaction pooler URL (port 6543) for web workloads.
DATABASE_URL=postgresql://postgres.<project-ref>:[PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Optional aliases supported for backward compatibility:
BETTER_AUTH_DATABASE_URL=
SUPABASE_DB_URL=

# NOTE: These public Supabase keys are only required if you use `@supabase/supabase-js`
# on the frontend (Auth/Storage/Realtime through Supabase API). Current Better Auth +
# direct Postgres implementation does NOT require them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Better Auth JWT contract used by FastAPI verifier.
BETTER_AUTH_JWT_ISSUER=http://127.0.0.1:3000
BETTER_AUTH_JWT_AUDIENCE=http://127.0.0.1:8000

# Optional extra dev origins (comma-separated), useful for ngrok/local tunneling.
# Example: ALLOWED_DEV_ORIGINS=abcd-1234.ngrok-free.app
ALLOWED_DEV_ORIGINS=

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Required for email/password auth flows (verification + password reset)
RESEND_API_KEY=
AUTH_EMAIL_FROM=Skrap <auth@your-domain.com>
AUTH_EMAIL_REPLY_TO=
AUTH_EMAIL_APP_NAME=Dealvinci

# Paddle Billing
PADDLE_ENV=sandbox
NEXT_PUBLIC_PADDLE_ENV=sandbox
PADDLE_API_KEY=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Either name is accepted by the webhook route.
PADDLE_WEBHOOK_SECRET=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
PADDLE_PLUS_PRICE_ID=
PADDLE_PRO_PRICE_ID=
BILLING_BACKEND_SECRET=
